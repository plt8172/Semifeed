{
  "name": "semiwire - fetch to slack review",
  "nodes": [
    {
      "parameters": {},
      "id": "manual_trigger",
      "name": "수동 실행",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "feeds",
              "name": "feeds",
              "type": "array",
              "value": [
                "https://www.eetimes.com/feed/",
                "https://semiengineering.com/feed/",
                "https://www.trendforce.com/feed/Semiconductors.html",
                "https://spectrum.ieee.org/feeds/feed.rss",
                "https://www.tomshardware.com/feeds/all",
                "https://www.theregister.com/?lab_viewport=rss",
                "https://blogs.nvidia.com/feed/",
                "https://news.samsung.com/global/feed/rss",
                "https://www.thelec.kr/rss/allArticle.xml",
                "https://rss.etnews.com/Section901.xml"
              ]
            },
            { "id": "hours", "name": "hours_window", "type": "number", "value": 24 },
            { "id": "slack_channel", "name": "slack_channel_id", "type": "string", "value": "C0C209QAURH" },
            { "id": "max_items", "name": "max_items", "type": "number", "value": 1 }
          ]
        }
      },
      "id": "config",
      "name": "설정 (RSS 목록)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "feeds",
        "options": {}
      },
      "id": "split_feeds",
      "name": "피드별로 분리",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.feeds }}"
      },
      "id": "rss_read",
      "name": "RSS 읽기",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [660, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "recent",
              "leftValue": "={{ (Date.now() - new Date($json.isoDate).getTime()) / 3600000 }}",
              "rightValue": "={{ $('설정 (RSS 목록)').first().json.hours_window }}",
              "operator": { "type": "number", "operation": "lt" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "filter_recent",
      "name": "최근 N시간 필터",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "jsCode": "// 이미 처리한 링크는 워크플로우 static data에 저장해서 중복 방지\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.postedLinks) staticData.postedLinks = [];\n\nconst out = [];\nfor (const item of $input.all()) {\n  const link = item.json.link;\n  if (!staticData.postedLinks.includes(link)) {\n    out.push(item);\n  }\n}\n\n// 테스트/운영 시 처리 기사 수를 중앙 설정에서 제한\nconst maxItems = Math.max(1, Number($('설정 (RSS 목록)').first().json.max_items || 3));\nreturn out.slice(0, maxItems);"
      },
      "id": "dedupe",
      "name": "중복 제거",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-OpenRouter-Title", "value": "semifeed" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"~anthropic/claude-sonnet-latest\", max_tokens: 400, temperature: 0.2, messages: [{ role: \"user\", content: `다음 기사를 반도체/테크 인스타 카드용으로 한국어로 요약해줘. JSON만 출력: {\\\"headline\\\": \\\"12단어 이내 헤드라인\\\", \\\"bullets\\\": [\\\"짧은 요약1\\\", \\\"짧은 요약2\\\", \\\"짧은 요약3\\\"], \\\"source\\\": \\\"매체명\\\"}\\n\\n제목: ${$json.title}\\n링크: ${$json.link}\\n본문요약: ${$json.contentSnippet || ''}` }] }) }}"
      },
      "id": "openrouter_summarize",
      "name": "OpenRouter로 카드 문구 생성",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 300]
    },
    {
      "parameters": {
        "jsCode": "// OpenRouter Chat Completions 응답 파싱 + HTML 카드 조립\nconst results = [];\nconst responseItems = $input.all();\nconst sourceItems = $('중복 제거').all();\nfor (let index = 0; index < responseItems.length; index++) {\n  const item = responseItems[index];\n  const sourceItem = sourceItems[index]?.json || {};\n  let card;\n  try {\n    const content = item.json.choices?.[0]?.message?.content;\n    const text = typeof content === 'string'\n      ? content\n      : Array.isArray(content)\n        ? content.map(part => part?.text || '').join('')\n        : '';\n    card = JSON.parse(text.replace(/```json|```/g, '').trim());\n  } catch (e) {\n    continue; // 파싱 실패한 항목은 건너뜀\n  }\n\n  const bulletsHtml = card.bullets.map(b => `<li>${b}</li>`).join('');\n  const html = `\n  <html><head><style>\n    body { margin:0; width:1080px; height:1080px; background:#0d0d0d; color:#fff; font-family: 'Pretendard', sans-serif; padding:80px; box-sizing:border-box; }\n    h1 { font-size:56px; line-height:1.3; margin-bottom:50px; }\n    ul { font-size:32px; line-height:1.8; padding-left:30px; }\n    .source { position:absolute; bottom:60px; left:80px; font-size:24px; color:#888; }\n  </style></head>\n  <body>\n    <h1>${card.headline}</h1>\n    <ul>${bulletsHtml}</ul>\n    <div class=\"source\">출처: ${card.source}</div>\n  </body></html>`;\n\n  results.push({ json: { html, caption: `${card.headline}\\n\\n${card.bullets.join('\\n')}\\n\\n출처: ${card.source} | ${sourceItem.link}`, link: sourceItem.link } });\n}\nreturn results;"
      },
      "id": "build_html",
      "name": "HTML 카드 조립",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "mode": "id",
          "value": "={{ $('설정 (RSS 목록)').first().json.slack_channel_id }}"
        },
        "text": "={{ $('HTML 카드 조립').item.json.caption }}",
        "messageType": "text",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "slack_review_parent",
      "name": "Slack 승인 요청 시작",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1760, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://browserless:3000/screenshot",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ html: $('HTML 카드 조립').item.json.html, options: { type: 'png', fullPage: false, clip: { x: 0, y: 0, width: 1080, height: 1080 } } }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "render_image",
      "name": "카드 이미지 렌더링 (browserless)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 300]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "binaryPropertyName": "data",
        "options": {
          "channelId": "={{ $('설정 (RSS 목록)').first().json.slack_channel_id }}",
          "fileName": "semifeed-card.png",
          "threadTs": "={{ $('Slack 승인 요청 시작').item.json.ts }}",
          "title": "semifeed news card"
        }
      },
      "id": "slack_upload_card",
      "name": "Slack에 카드 파일 업로드",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [2200, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendAndWait",
        "select": "channel",
        "channelId": {
          "mode": "id",
          "value": "={{ $('설정 (RSS 목록)').first().json.slack_channel_id }}"
        },
        "message": "이 카드의 발행 여부를 선택해주세요.",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "승인",
            "buttonApprovalStyle": "primary",
            "disapproveLabel": "반려",
            "buttonDisapprovalStyle": "secondary"
          }
        },
        "captureResponder": false,
        "options": {
          "appendAttribution": false,
          "thread_ts": {
            "replyValues": {
              "thread_ts": "={{ $('Slack 승인 요청 시작').item.json.ts }}",
              "reply_broadcast": false
            }
          }
        }
      },
      "id": "slack_review_buttons",
      "name": "Slack 승인 버튼 메시지",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [2420, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "is_approved",
              "leftValue": "={{ String($json.data.approved) }}",
              "rightValue": "true",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if_approved",
      "name": "승인됨?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2640, 300]
    },
    {
      "parameters": {
        "jsCode": "// TODO: Instagram Graph API 연동 자리\n// 1) POST /{ig-user-id}/media  (image_url, caption)\n// 2) POST /{ig-user-id}/media_publish (creation_id)\n// API 승인 전까지는 여기서 파일을 '발행 대기' 폴더에 저장해두고 수동 업로드\nconst link = $('HTML 카드 조립').first().json.link;\nconst staticData = $getWorkflowStaticData('global');\nif (!Array.isArray(staticData.postedLinks)) staticData.postedLinks = [];\nif (!staticData.postedLinks.includes(link)) staticData.postedLinks.push(link);\nreturn [{ json: { status: 'approved - ready to publish', link } }];"
      },
      "id": "publish_stub",
      "name": "발행 (TODO: Instagram API)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2860, 220]
    },
    {
      "parameters": {
        "jsCode": "const link = $('HTML 카드 조립').first().json.link;\nreturn [{ json: { status: 'rejected', link } }];"
      },
      "id": "reject_stub",
      "name": "반려 처리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2860, 380]
    }
  ],
  "connections": {
    "수동 실행": { "main": [[{ "node": "설정 (RSS 목록)", "type": "main", "index": 0 }]] },
    "설정 (RSS 목록)": { "main": [[{ "node": "피드별로 분리", "type": "main", "index": 0 }]] },
    "피드별로 분리": { "main": [[{ "node": "RSS 읽기", "type": "main", "index": 0 }]] },
    "RSS 읽기": { "main": [[{ "node": "최근 N시간 필터", "type": "main", "index": 0 }]] },
    "최근 N시간 필터": { "main": [[{ "node": "중복 제거", "type": "main", "index": 0 }]] },
    "중복 제거": { "main": [[{ "node": "OpenRouter로 카드 문구 생성", "type": "main", "index": 0 }]] },
    "OpenRouter로 카드 문구 생성": { "main": [[{ "node": "HTML 카드 조립", "type": "main", "index": 0 }]] },
    "HTML 카드 조립": { "main": [[{ "node": "Slack 승인 요청 시작", "type": "main", "index": 0 }]] },
    "Slack 승인 요청 시작": { "main": [[{ "node": "카드 이미지 렌더링 (browserless)", "type": "main", "index": 0 }]] },
    "카드 이미지 렌더링 (browserless)": { "main": [[{ "node": "Slack에 카드 파일 업로드", "type": "main", "index": 0 }]] },
    "Slack에 카드 파일 업로드": { "main": [[{ "node": "Slack 승인 버튼 메시지", "type": "main", "index": 0 }]] },
    "Slack 승인 버튼 메시지": { "main": [[{ "node": "승인됨?", "type": "main", "index": 0 }]] },
    "승인됨?": {
      "main": [
        [{ "node": "발행 (TODO: Instagram API)", "type": "main", "index": 0 }],
        [{ "node": "반려 처리", "type": "main", "index": 0 }]
      ]
    }
  }
}
