{
  "title": "안드로이드 폰은 1초에 250번 하던 일을 멈춘다 (타이머 인터럽트)",
  "fps": 30,
  "voice": {"backend": "auto", "sid": 2, "speed": 1.12, "openai_voice": "coral"},
  "bgm": {"type": "pad", "gain": 0.03},
  "stage": "stage.html",
  "lines": [
    {"id": "h1", "say": "안드로이드 폰은 일초에 이백오십번, 하던 일을 멈춰요.", "caption": "", "after": 0.25},
    {"id": "h2", "say": "고장이 아니라, 일부러요.", "after": 0.45},
    {"id": "p1", "say": "음악 들으면서 카톡 하고, 화면도 움직이잖아요.", "after": 0.25},
    {"id": "p2", "say": "근데 씨피유 코어 하나는, 한 번에 딱 한 가지만 해요.", "caption": "근데 CPU 코어 하나는, 한 번에 딱 한 가지만 해요.", "after": 0.25},
    {"id": "p3", "say": "그래서 아주 잠깐씩 돌아가면서 하는데요,", "after": 0.2},
    {"id": "p4", "say": "문제는 누가 순서를 넘겨주냐예요.", "after": 0.45},
    {"id": "x1", "say": "앱들한테 알아서 넘기라고 하면,", "after": 0.2},
    {"id": "x2", "say": "음악 틀어 놓고 무거운 앱을 켜는 순간,", "clips": [{"file": "audio/r1.wav", "gain": 0.55, "at": "w:놓고"}], "after": 0.3},
    {"id": "x3", "say": "무거운 앱이 씨피유를 꽉 잡고 안 놓거든요.", "caption": "무거운 앱이 CPU를 꽉 잡고 안 놓거든요.", "after": 0.45},
    {"id": "t1", "say": "그래서 칩 안에 타이머가 하나 들어 있어요.", "after": 0.25},
    {"id": "t2", "say": "시간을 재다가, 정해진 시간이 되면,", "after": 0.15},
    {"id": "t3", "say": "누가 뭘 하든 씨피유를 멈춰 세우고,", "caption": "누가 뭘 하든 CPU를 멈춰 세우고,", "after": 0.15},
    {"id": "t4", "say": "다음 차례로 넘겨요.", "after": 0.5},
    {"id": "r2a", "say": "일초에 열번 멈추면,", "caption": "1초에 10번 멈추면,", "clips": [{"file": "audio/r2.wav", "gain": 0.7, "gap": 0.25}], "after": 0.25},
    {"id": "r2b", "say": "아직 끊기죠?", "after": 0.2},
    {"id": "r2c", "say": "음악 앱 차례가 오기 전에, 미리 만든 소리가 바닥나서요.", "after": 0.45},
    {"id": "r3a", "say": "일초에 이백오십번 멈추면,", "caption": "1초에 250번 멈추면,", "clips": [{"file": "audio/r3.wav", "gain": 0.7, "gap": 0.25}], "after": 0.25},
    {"id": "r3b", "say": "이제 안 끊겨요.", "after": 0.5},
    {"id": "e1", "say": "이게 타이머 인터럽트예요.", "after": 0.3},
    {"id": "e2", "say": "지금 이 영상이 안 끊기는 것도, 폰이 계속 하던 일을 멈추고 있어서 그래요.", "after": 0.6}
  ]
}
