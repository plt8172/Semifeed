  "lines": [
    {"id": "h1", "say": "통화할 때 들리는 목소리.", "caption": "", "after": 0.25},
    {"id": "h2", "say": "그거, 상대방 목소리 아니에요.", "caption": "", "after": 0.35},
    {"id": "h3", "say": "내 폰이 방금 만들어 낸 소리예요.", "after": 0.45},
    {"id": "p1", "say": "소리는 공기의 떨림이에요.", "after": 0.22},
    {"id": "p2", "say": "그대로 보내려면, 이 떨림을 일초에 팔천번 재야 해요.", "caption": "그대로 보내려면, 이 떨림을 1초에 8,000번 재야 해요.", "sfx": [{"type": "pop", "at": "w:8,000", "gain": 0.18}], "after": 0.22},
    {"id": "p3", "say": "영과 일로 적으면, 육만 사천 칸이에요.", "caption": "0과 1로 적으면, 64,000칸이에요.", "after": 0.3},
    {"id": "p4", "say": "모두가 동시에 통화하기엔 너무 많아요.", "after": 0.4},
    {"id": "o1", "say": "그런데 아 소리를 확대해 보면,", "caption": "그런데 '아' 소리를 확대해 보면,", "after": 0.15},
    {"id": "o2", "say": "같은 모양이 계속 반복돼요.", "after": 0.5, "sfx": [{"type": "tick", "at": 0.5}, {"type": "tick", "at": 0.9}, {"type": "tick", "at": 1.3}, {"type": "tick", "at": 1.7}]},
    {"id": "m1", "say": "성대가 일정하게 떨기 때문이에요.", "after": 0.3},
    {"id": "m2", "say": "성대 소리만 들으면 이래요.", "clips": [{"file": "audio/buzz.wav", "gain": 0.5, "gap": 0.2}], "after": 0.22},
    {"id": "m3", "say": "여기에 입 모양이 더해지면,", "clips": [{"file": "audio/a.wav", "gain": 0.6, "gap": 0.2}], "after": 0.22},
    {"id": "m4", "say": "입 모양만 바꾸면,", "clips": [{"file": "audio/ai.wav", "gain": 0.6, "gap": 0.2}], "after": 0.4},
    {"id": "s1", "say": "그래서 폰은 소리를 보내지 않아요.", "after": 0.25},
    {"id": "s2", "say": "얼마나 빨리 떠는지, 입 모양이 어떤지.", "after": 0.22},
    {"id": "s3", "say": "이 숫자 몇 개만, 일 초에 오십 번 보내요.", "caption": "이 숫자 몇 개만, 1초에 50번 보내요.", "after": 0.22},
    {"id": "s4", "say": "받는 폰은 그 숫자로 목소리를 다시 만들어요.", "after": 0.7},
    {"id": "d1", "say": "데이터를 전부 보낸 소리.", "clips": [{"file": "audio/A.wav", "gap": 0.2}], "after": 0.22},
    {"id": "d2", "say": "오 분의 일만 보낸 소리.", "caption": "5분의 1만 보낸 소리.", "clips": [{"file": "audio/B.wav", "gap": 0.2}], "after": 0.22},
    {"id": "d3", "say": "구십 분의 일만 보낸 소리.", "caption": "90분의 1만 보낸 소리.", "clips": [{"file": "audio/C.wav", "gap": 0.2}], "after": 0.3},
    {"id": "e1", "say": "구십 분의 일인데도, 알아들을 수 있어요.", "caption": "90분의 1인데도, 알아들을 수 있어요.", "after": 0.3},
    {"id": "e2", "say": "이 기술이 보코딩이에요.", "after": 0.3},
    {"id": "e3", "say": "오늘 통화한 그 목소리도, 폰이 만든 소리였어요.", "after": 0.6}
