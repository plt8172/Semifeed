  "lines": [
    {"id": "h1", "say": "통화할 때 듣는 목소리 있잖아요.", "caption": "", "after": 0.25},
    {"id": "h2", "say": "그거 상대방 목소리 아니에요.", "caption": "", "after": 0.35},
    {"id": "h3", "say": "내 폰이 성대모사 하는 거예요.", "after": 0.45},
    {"id": "p1", "say": "소리는 공기가 떨리는 건데요,", "after": 0.22},
    {"id": "p2", "say": "이걸 그대로 보내려면, 일초에 팔천번을 재야 돼요.", "caption": "이걸 그대로 보내려면, 1초에 8,000번을 재야 돼요.", "sfx": [{"type": "pop", "at": "w:8,000", "gain": 0.18}], "after": 0.22},
    {"id": "p3", "say": "영이랑 일로 바꾸면, 일초에 육만 사천 개.", "caption": "0이랑 1로 바꾸면, 1초에 64,000개.", "after": 0.3},
    {"id": "p4", "say": "이러면 동시에 몇 명밖에 통화를 못 해요.", "after": 0.4},
    {"id": "o1", "say": "근데 아 하는 소리를 확대해 보면,", "caption": "근데 '아' 하는 소리를 확대해 보면,", "after": 0.15},
    {"id": "o2", "say": "똑같은 모양이 계속 반복돼요.", "sfx": [{"type": "tick", "at": 0.5}, {"type": "tick", "at": 0.9}, {"type": "tick", "at": 1.3}, {"type": "tick", "at": 1.7}], "after": 0.5},
    {"id": "m1", "say": "성대가 일정하게 떨려서 그래요.", "after": 0.3},
    {"id": "m2", "say": "성대 소리만 따로 들으면 이런데요,", "clips": [{"file": "audio/buzz.wav", "gain": 0.5, "gap": 0.2}], "after": 0.22},
    {"id": "m3", "say": "여기에 입 모양을 씌우면,", "clips": [{"file": "audio/a.wav", "gain": 0.6, "gap": 0.2}], "after": 0.22},
    {"id": "m4", "say": "입 모양만 바꾸면,", "clips": [{"file": "audio/ai.wav", "gain": 0.6, "gap": 0.2}], "after": 0.4},
    {"id": "s1", "say": "그럼 소리를 통째로 보낼 필요가 없잖아요.", "after": 0.25},
    {"id": "s2", "say": "성대가 얼마나 빨리 떠는지, 입 모양이 어떤지.", "after": 0.22},
    {"id": "s3", "say": "이 숫자 몇 개만 일초에 오십번 보내면,", "caption": "이 숫자 몇 개만 1초에 50번 보내면,", "after": 0.22},
    {"id": "s4", "say": "받는 폰이 그걸로 목소리를 새로 만들어요.", "after": 0.7},
    {"id": "d1", "say": "전부 다 보내면,", "clips": [{"file": "audio/A.wav", "gap": 0.2}], "after": 0.22},
    {"id": "d2", "say": "오 분의 일만 보내면,", "caption": "5분의 1만 보내면,", "clips": [{"file": "audio/B.wav", "gap": 0.2}], "after": 0.22},
    {"id": "d3", "say": "구십 분의 일만 보내면,", "caption": "90분의 1만 보내면,", "clips": [{"file": "audio/C.wav", "gap": 0.2}], "after": 0.3},
    {"id": "e1", "say": "구십 분의 일인데, 무슨 말인지 들리죠?", "caption": "90분의 1인데, 무슨 말인지 들리죠?", "after": 0.3},
    {"id": "e2", "say": "이게 보코딩이에요.", "after": 0.3},
    {"id": "e3", "say": "오늘 통화한 그 목소리도, 폰이 한 성대모사였어요.", "after": 0.6}
  ]
}
