      },
      "id": "filter_recent",
      "name": "최근 N시간 필터",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "jsCode": "// 이미 게시한 링크는 제외하고, 실행 시간대별로 출처를 순환해 특정 매체 편중을 방지\nconst staticData = $getWorkflowStaticData('global');\nif (!Array.isArray(staticData.postedLinks)) staticData.postedLinks = [];\n\nconst config = $('설정 (RSS 목록)').first().json.config;\nconst maxItems = Math.max(1, Number(config.max_items || 5));\nconst bySource = new Map();\n\nfor (const item of $input.all()) {\n  const link = String(item.json.link || '');\n  if (!link || staticData.postedLinks.includes(link)) continue;\n\n  // n8n 태스크 러너 샌드박스에는 URL 전역이 없으므로 정규식으로 호스트를 추출한다.\n  const host = /^https?:\\/\\/([^/?#]+)/i.exec(link);\n  const source = host ? host[1].toLowerCase().replace(/^www\\./, '').replace(/:\\d+$/, '') : 'unknown';\n\n  if (!bySource.has(source)) bySource.set(source, []);\n  bySource.get(source).push(item);\n}\n\nfor (const items of bySource.values()) {\n  items.sort((a, b) => {\n    const aTime = new Date(a.json.isoDate || a.json.pubDate || 0).getTime() || 0;\n    const bTime = new Date(b.json.isoDate || b.json.pubDate || 0).getTime() || 0;\n    return bTime - aTime;\n  });\n}\n\nconst sources = [...bySource.keys()].sort();\nif (!sources.length) return [];\n\n// Asia/Seoul의 날짜와 09/12/17/21시 실행 슬롯으로 시작 출처를 결정한다.\n// 상태 저장에 의존하지 않아 이전 실행이 실패해도 다음 슬롯은 다른 출처 묶음을 선택한다.\nconst kstNow = new Date(Date.now() + 9 * 60 * 60 * 1000);\nconst hour = kstNow.getUTCHours();\nconst slot = hour >= 21 ? 3 : hour >= 17 ? 2 : hour >= 12 ? 1 : 0;\nconst dayNumber = Math.floor(Date.UTC(kstNow.getUTCFullYear(), kstNow.getUTCMonth(), kstNow.getUTCDate()) / 86400000);\nconst start = ((dayNumber * 4 + slot) * maxItems) % sources.length;\n\nconst selected = [];\nfor (let offset = 0; offset < sources.length && selected.length < maxItems; offset++) {\n  const source = sources[(start + offset) % sources.length];\n  const article = bySource.get(source)?.[0];\n  if (article) selected.push(article);\n}\n\nreturn selected;"
      },
