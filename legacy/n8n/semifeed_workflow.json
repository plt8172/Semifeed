          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "recent",
              "leftValue": "={{ (Date.now() - new Date($json.isoDate).getTime()) / 3600000 }}",
              "rightValue": "={{ $('설정 (RSS 목록)').first().json.config.hours_window }}",
