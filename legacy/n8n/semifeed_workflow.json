      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-OpenRouter-Title", "value": "semifeed" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"~anthropic/claude-sonnet-latest\", max_tokens: 400, temperature: 0.2, messages: [{ role: \"user\", content: `다음 기사를 반도체/테크 인스타 카드용으로 한국어로 요약해줘. JSON만 출력: {\\\"headline\\\": \\\"12단어 이내 헤드라인\\\", \\\"bullets\\\": [\\\"짧은 요약1\\\", \\\"짧은 요약2\\\", \\\"짧은 요약3\\\"], \\\"source\\\": \\\"매체명\\\"}\\n\\n제목: ${$json.title}\\n링크: ${$json.link}\\n본문요약: ${$json.contentSnippet || ''}` }] }) }}"
      },
      "id": "openrouter_summarize",
      "name": "OpenRouter로 카드 문구 생성",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "credentials": {
        "httpHeaderAuth": {
          "id": "ilgiQDECADVKCCZa",
          "name": "Openrouter Header Auth"
        }
      },
      "position": [1320, 300]
    },
    {
      "parameters": {
        "jsCode": "// OpenRouter Chat Completions 응답 파싱 + HTML 카드 조립\nconst results = [];\nconst responseItems = $input.all();\nconst sourceItems = $('중복 제거').all();\nfor (let index = 0; index < responseItems.length; index++) {\n  const item = responseItems[index];\n  const sourceItem = sourceItems[index]?.json || {};\n  let card;\n  try {\n    const content = item.json.choices?.[0]?.message?.content;\n    const text = typeof content === 'string'\n      ? content\n      : Array.isArray(content)\n        ? content.map(part => part?.text || '').join('')\n        : '';\n    card = JSON.parse(text.replace(/```json|```/g, '').trim());\n  } catch (e) {\n    continue; // 파싱 실패한 항목은 건너뜀\n  }\n\n  const bulletsHtml = card.bullets.map(b => `<li>${b}</li>`).join('');\n  const html = `\n  <html><head><style>\n    body { margin:0; width:1080px; height:1080px; background:#0d0d0d; color:#fff; font-family: 'Pretendard', sans-serif; padding:80px; box-sizing:border-box; }\n    h1 { font-size:56px; line-height:1.3; margin-bottom:50px; }\n    ul { font-size:32px; line-height:1.8; padding-left:30px; }\n    .source { position:absolute; bottom:60px; left:80px; font-size:24px; color:#888; }\n  </style></head>\n  <body>\n    <h1>${card.headline}</h1>\n    <ul>${bulletsHtml}</ul>\n    <div class=\"source\">출처: ${card.source}</div>\n  </body></html>`;\n\n  results.push({ json: { html, caption: `${card.headline}\\n\\n${card.bullets.join('\\n')}\\n\\n출처: ${card.source} | ${sourceItem.link}`, link: sourceItem.link } });\n}\nreturn results;"
      },
