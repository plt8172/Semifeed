    {
      "parameters": {
        "jsCode": "const config = $('설정 (RSS 목록)').first().json.config;\nconst publicBaseUrl = String(config.n8n_public_base_url || '').replace(/\\/+$/, '');\nif (!publicBaseUrl.startsWith('https://') || publicBaseUrl.includes('YOUR_PUBLIC_N8N_HOST')) {\n  throw new Error('config/semifeed.json의 n8n_public_base_url을 외부에서 접근 가능한 HTTPS n8n 기본 주소로 설정하세요.');\n}\n\nreturn $input.all().map((item, index) => {\n  const randomPart = Math.random().toString(36).slice(2, 12);\n  const mediaFileName = `semifeed-${$execution.id}-${Date.now()}-${index}-${randomPart}.jpg`;\n  return {\n    json: {\n      ...item.json,\n      media_file_name: mediaFileName,\n      public_image_url: `${publicBaseUrl}/webhook/semifeed-media?file=${encodeURIComponent(mediaFileName)}`,\n    },\n    binary: item.binary,\n    pairedItem: item.pairedItem,\n  };\n});"
      },
